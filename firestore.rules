rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /tournaments/{tourneyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
                      && playerId == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.feePaid == false
                      && request.resource.data.category == "PENDING"
                      && (!("teamId" in request.resource.data) || request.resource.data.teamId == null);
        allow update, delete: if isAdmin();
      }
      
      match /captains/{captainId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
      
      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
                      && request.resource.data.captainUid == request.auth.uid
                      && exists(/databases/$(database)/documents/tournaments/$(tourneyId)/captains/$(request.auth.uid));
        allow update, delete: if isAdmin();
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
